{
  "name": "nimfasele",
  "version": "1.0.0",
  "description": "نیم‌فاصله‌گذار خودکار متن فارسی — Persian half-space (ZWNJ) fixer with zero runtime dependencies",
  "keywords": [
    "persian",
    "farsi",
    "zwnj",
    "half-space",
    "نیم‌فاصله",
    "فارسی",
    "typography",
    "rtl"
  ],
  "license": "MIT",
  "author": "nimfasele contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alizamani1616/nimfasele.git"
  },
  "homepage": "https://github.com/alizamani1616/nimfasele#readme",
  "bugs": {
    "url": "https://github.com/alizamani1616/nimfasele/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nimfasele": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.cli.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo:dev": "vite",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@fontsource/vazirmatn": "^5.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^3.0.0"
  }
}
